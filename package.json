{
  "name": "wow-forever-team-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "blizzard:check": "node --experimental-strip-types --env-file=.env.local scripts/check-blizzard-oauth.ts",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "keys:seed-admin": "node scripts/seed-admin.mjs",
    "keys:seed": "node scripts/access-keys.mjs seed",
    "keys:rotate": "node scripts/access-keys.mjs rotate",
    "test:e2e": "playwright test",
    "media:capture": "playwright test --config scripts/capture-ui.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
